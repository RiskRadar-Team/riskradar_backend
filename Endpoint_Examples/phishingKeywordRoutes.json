{
  "examples":[
    {
      "request":{
        "url":"http://localhost:5000/riskradar/keyword/",
        "method":"POST",
        "credentials":"include",
        "headers": {
        "Authorization": "Bearer <accessToken>"
        },
        "body":{
          "keyword": "Tax refund --",
          "category": "GOVERNMENT",
          "severity": 4,
          "match_type": "CONTAINS",
          "score": 80,
          "description": "Phishing emails often impersonate government agencies promising tax refunds to lure victims.",
          "example": "You are eligible for a tax refund. Click here to claim your payment.",
          "is_case_sensitive": false
        }
      },
      "response":{
        "success": true,
        "statusCode": 201,
        "message": "Domain created successfully",
        "data": "Data is displayed as other create request"
    },
    "Note":"keyword,category and severity are required fields "
      
    },
    {
      "message for frontend":"All the responses for phishing keyword is similar to domains so from here no response will be shown."
    },
    {
      "request":{
        "url":"http://localhost:5000/riskradar/keyword/<id>",
        "method":"PUT",
        "credentials":"include",
        "headers":{
          "Authorization":"Bearer <accessToken>"
        },
        "body":{
          "keyword": "Tax refund updated",
          "category": "GOVERNMENT",
          "severity": 4,
          "match_type": "CONTAINS",
          "score": 80,
          "description": "Phishing emails often impersonate government agencies promising tax refunds to lure victims.",
          "example": "You are eligible for a tax refund. Click here to claim your payment.",
          "is_case_sensitive": false
        }
      }
     
    },
